NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*
REALTIME_TOKEN_SECRET=dev-secret-change-me-in-production
REALTIME_TOKEN_TTL_SECONDS=300
DEV_AUTH_MODE=true

# Providers: mock | deepgram | openai  (speech)
#            mock | openai             (translation)
SPEECH_PROVIDER=deepgram
TRANSLATION_PROVIDER=openai

# Required for TRANSLATION_PROVIDER=openai and RETRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=

# Required for SPEECH_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Low-confidence transcript correction (server-side)
# Pipeline: quality eval → optional Whisper re-transcription → deterministic game-aware normalization
# NOTE: Normalization is NOT a separate provider — it uses game profile phoneticAliases locally.
TRANSCRIPT_CORRECTION_ENABLED=true
TRANSCRIPT_CONFIDENCE_THRESHOLD=0.72
RETRANSCRIBE_TIMEOUT_MS=2500
AUDIO_BUFFER_MAX_SECONDS=45
# mock | openai | none — MUST be openai for real re-transcription (requires OPENAI_API_KEY)
RETRANSCRIBE_PROVIDER=openai

# Topic-aware translation routing (game vs general conversation)
# Classifies each finalized segment so PoE/game context is only applied when appropriate.
TOPIC_ROUTING_ENABLED=true
TOPIC_GAME_THRESHOLD=3
TOPIC_GENERAL_THRESHOLD=3
TOPIC_MINIMUM_MARGIN=1.5
# Consecutive strong general segments required before leaving game mode
TOPIC_GENERAL_SWITCH_SEGMENTS=2
# Consecutive strong game segments required to enter/return to game mode
TOPIC_GAME_SWITCH_SEGMENTS=1
TOPIC_CONTEXT_GAME_SEGMENTS=5
TOPIC_CONTEXT_GENERAL_SEGMENTS=5
TOPIC_CONTEXT_MIXED_SEGMENTS=3
# Optional LLM fallback for hard uncertain cases (default off — deterministic only)
TOPIC_CLASSIFIER_LLM_FALLBACK_ENABLED=false

# Sentence assembly — hold incomplete STT finals and merge continuations before translation
SENTENCE_ASSEMBLY_ENABLED=true
# Adaptive hold windows (ms); complete sentences flush immediately
SENTENCE_HOLD_MIN_MS=250
SENTENCE_HOLD_DEFAULT_MS=650
SENTENCE_HOLD_UNCERTAIN_MS=450
SENTENCE_HOLD_STRONG_INCOMPLETE_MS=1000
SENTENCE_HOLD_MAX_MS=1200
# Gap between segments: short → merge signal; hard → never merge
SENTENCE_SHORT_GAP_MS=700
SENTENCE_HARD_GAP_MS=1500
# Pending utterance safety limits
SENTENCE_MAX_SEGMENTS=3
SENTENCE_MAX_DURATION_MS=10000
SENTENCE_MAX_WORDS=45
SENTENCE_MAX_CHARACTERS=280
SENTENCE_MERGE_SCORE_THRESHOLD=4
# Dev-only fragment/merge logging (never logs full transcript in production metrics)
SENTENCE_DIAGNOSTICS_ENABLED=false

LOG_LEVEL=info
MAX_WS_PAYLOAD_BYTES=65536
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
CHUNK_DURATION_MS=100

# --- Production checklist (.env) ---
# NODE_ENV=production
# DEV_AUTH_MODE=false
# REALTIME_TOKEN_SECRET=<long-random-secret>
# SPEECH_PROVIDER=deepgram
# TRANSLATION_PROVIDER=openai
# RETRANSCRIBE_PROVIDER=openai
# TRANSCRIPT_CORRECTION_ENABLED=true
# OPENAI_API_KEY=...
# DEEPGRAM_API_KEY=...
# DEEPGRAM_MODEL=nova-2
