NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*
REALTIME_TOKEN_SECRET=dev-secret-change-me-in-production
REALTIME_TOKEN_TTL_SECONDS=300
DEV_AUTH_MODE=true

# Providers: mock | deepgram | openai  (speech)
#            mock | openai             (translation)
SPEECH_PROVIDER=deepgram
TRANSLATION_PROVIDER=openai

# Required for TRANSLATION_PROVIDER=openai and RETRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=

# Required for SPEECH_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Low-confidence transcript correction (server-side)
# Pipeline: quality eval → optional Whisper re-transcription → deterministic game-aware normalization
# NOTE: Normalization is NOT a separate provider — it uses game profile phoneticAliases locally.
TRANSCRIPT_CORRECTION_ENABLED=true
TRANSCRIPT_CONFIDENCE_THRESHOLD=0.72
RETRANSCRIBE_TIMEOUT_MS=2500
AUDIO_BUFFER_MAX_SECONDS=45
# mock | openai | none — MUST be openai for real re-transcription (requires OPENAI_API_KEY)
RETRANSCRIBE_PROVIDER=openai

LOG_LEVEL=info
MAX_WS_PAYLOAD_BYTES=65536
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
CHUNK_DURATION_MS=100

# --- Production checklist (.env) ---
# NODE_ENV=production
# DEV_AUTH_MODE=false
# REALTIME_TOKEN_SECRET=<long-random-secret>
# SPEECH_PROVIDER=deepgram
# TRANSLATION_PROVIDER=openai
# RETRANSCRIBE_PROVIDER=openai
# TRANSCRIPT_CORRECTION_ENABLED=true
# OPENAI_API_KEY=...
# DEEPGRAM_API_KEY=...
# DEEPGRAM_MODEL=nova-2
